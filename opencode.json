{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "default_agent": "build",
  "instructions": [
    "./AGENTS.md"
  ],
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "skill": {
      "*": "allow"
    },
    "edit": "ask",
    "bash": {
      "*": "ask",
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git show": "allow",
      "git show *": "allow",
      "git branch": "allow",
      "git branch *": "allow",
      "git remote": "allow",
      "git remote *": "allow",
      "git rev-parse *": "allow",
      "git ls-files *": "allow",
      "git grep *": "allow",
      "Get-Content *": "allow",
      "Get-ChildItem *": "allow",
      "Select-String *": "allow",
      "Test-Path *": "allow",
      "where.exe php": "allow",
      "where.exe git": "allow",
      "php -v": "allow",
      "php --version": "allow",
      "php -l *": "allow",
      "pwsh -NoProfile -File scripts/check-environment.ps1*": "allow",
      "pwsh -NoProfile -File scripts/check-php.ps1*": "allow",
      "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-environment.ps1*": "allow",
      "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-php.ps1*": "allow"
    }
  },
  "agent": {
    "plan": {
      "description": "Analisa o php-dfe e prepara um plano sem alterar arquivos.",
      "mode": "primary",
      "model": "openai/gpt-5.6-luna",
      "prompt": "{file:./prompts/plan.txt}",
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny",
          "git status": "allow",
          "git status *": "allow",
          "git diff": "allow",
          "git diff *": "allow",
          "git log": "allow",
          "git log *": "allow",
          "git show": "allow",
          "git show *": "allow",
          "git branch": "allow",
          "git branch *": "allow",
          "git remote": "allow",
          "git remote *": "allow",
          "git rev-parse *": "allow",
          "git ls-files *": "allow",
          "git grep *": "allow",
          "Get-Content *": "allow",
          "Get-ChildItem *": "allow",
          "Select-String *": "allow",
          "Test-Path *": "allow",
          "where.exe php": "allow",
          "where.exe git": "allow",
          "php -v": "allow",
          "php --version": "allow",
          "php -l *": "allow",
          "pwsh -NoProfile -File scripts/check-environment.ps1*": "allow",
          "pwsh -NoProfile -File scripts/check-php.ps1*": "allow"
        }
      }
    },
    "build": {
      "description": "Implementa mudanças no php-dfe com alterações mínimas e validação.",
      "mode": "primary",
      "model": "openai/gpt-5.6-luna",
      "prompt": "{file:./prompts/build.txt}",
      "permission": {
        "edit": "ask"
      }
    },
    "review": {
      "description": "Revisa o php-dfe sem editar arquivos.",
      "mode": "primary",
      "model": "openai/gpt-5.6-luna",
      "prompt": "{file:./prompts/review.txt}",
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny",
          "git status": "allow",
          "git status *": "allow",
          "git diff": "allow",
          "git diff *": "allow",
          "git log": "allow",
          "git log *": "allow",
          "git show": "allow",
          "git show *": "allow",
          "git branch": "allow",
          "git branch *": "allow",
          "git remote": "allow",
          "git remote *": "allow",
          "git rev-parse *": "allow",
          "git ls-files *": "allow",
          "git grep *": "allow",
          "Get-Content *": "allow",
          "Get-ChildItem *": "allow",
          "Select-String *": "allow",
          "Test-Path *": "allow",
          "where.exe php": "allow",
          "where.exe git": "allow",
          "php -v": "allow",
          "php --version": "allow",
          "php -l *": "allow",
          "pwsh -NoProfile -File scripts/check-environment.ps1*": "allow",
          "pwsh -NoProfile -File scripts/check-php.ps1*": "allow"
        }
      }
    }
  }
}
